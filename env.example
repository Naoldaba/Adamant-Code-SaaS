# --- Backend (apps/api) ---
# Used by API runtime and by Knex CLI (packages/db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ac_dev

# Interview scaffold auth (NOT production-grade password hashing)
PASSWORD_SALT=dev_salt_change_me

# Reserved for future expansion (e.g. signed sessions/JWT); not required by current scaffold.
SESSION_SECRET=dev_session_secret_change_me

# CORS for cookie-based auth
CORS_ORIGIN=http://localhost:3000

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Knowledge Assistant (RAG) ---
# Embedding vector dimension. Must match the DB migration column type and the
# configured provider. 768 = Gemini text-embedding-004 (native); also valid for the
# local fallback provider and OpenAI (pinned via its dimensions param). Changing
# this requires a fresh DB (down -v) + re-ingestion.
EMBEDDING_DIM=768

# Maximum size (in MB) for a Knowledge Uploader file upload. Larger files are
# rejected with a clear validation message.
KB_MAX_UPLOAD_MB=5

# RAG retrieval tuning. RAG_TOP_K chunks are pulled per question, then filtered by
# RAG_MIN_SCORE (cosine similarity). If nothing clears the threshold, the assistant
# returns an explicit insufficient-knowledge answer instead of guessing.
RAG_TOP_K=6
RAG_MIN_SCORE=0.1

# Provider selection for embeddings + answer generation. Priority is
# OpenAI > Gemini > offline local. Set exactly one key; if none is set, a
# deterministic offline local provider is used (no key required).
#
# OpenAI (paid):
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#
# Google Gemini (has a free tier). Get a key at https://aistudio.google.com/apikey
# gemini-embedding-001 is requested at 768 dims, so keep EMBEDDING_DIM=768.
# gemini-flash-lite-latest is used for answers (the -latest alias stays current and
# the lite tier is the most reliably available on the free tier).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
